# ─────────────────────────────────────────────────────────────
#  对韵 · AI 接口配置（可选）
#  不填也能跑：会自动降级到内置名联库 + 本地平仄/词性引擎
#
#  ⚠️ 这个文件只是「写法示例」。线上（Cloudflare Workers）的权威配置是：
#     · 非密钥  AI_BASE_URL / AI_MODEL / AI_TIMEOUT_MS
#         → 写在 wrangler.jsonc 的 "vars" 段里，随每次部署自动下发
#     · 密钥    AI_API_KEY
#         → 放 Cloudflare 控制台的 Variables and Secrets，类型必须选 Secret
#     两者都不要只写在控制台的明文变量里：`wrangler deploy` 每次部署
#     都会清空 Worker 上的明文变量（Secrets 不受影响）。
# ─────────────────────────────────────────────────────────────

# 任意「OpenAI 兼容」的 Chat Completions 端点，填到 /v1 为止
# 常见取值：
#   DeepSeek   https://api.deepseek.com/v1
#   OpenAI     https://api.openai.com/v1
#   通义千问   https://dashscope.aliyuncs.com/compatible-mode/v1
#   智谱 GLM   https://open.bigmodel.cn/api/paas/v4
#   魔搭       https://api-inference.modelscope.cn/v1
AI_BASE_URL=https://api-inference.modelscope.cn/v1

# 你的 API Key（只放在服务端，前端拿不到）
AI_API_KEY=

# 模型名，按你用的平台填
AI_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# 单次请求超时（毫秒），推理类模型会先想很久，留足余量
AI_TIMEOUT_MS=60000
