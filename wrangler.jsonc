{
  // 对韵 · 智能对联生成器 —— Cloudflare Workers 部署配置
  // ---------------------------------------------------------------
  // 服务端有两块：
  //   ① /api/generate       安全地调用 AI（不把 Key 暴露给浏览器）
  //   ② 账号 / 博客 / 收藏   读写 D1 数据库（见下面的 d1_databases 绑定）
  // 收藏默认仍存浏览器本地；登录后额外同步一份到云端（换设备可见）。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "duiyun",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-01-01",
  // nodejs_compat                     Next.js 内部用到部分 Node API，必须开
  // global_fetch_strictly_public      允许应用向外发起 fetch（调魔搭 API 必需）
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // ─────────────────────────────────────────────────────────────────
  //  非密钥配置：写在这里，随每次部署自动下发，永远不会丢
  // ─────────────────────────────────────────────────────────────────
  //  ⚠️ 只有「不敏感」的值能放这里 —— 这个文件会进 GitHub 仓库，
  //     任何人看到都无所谓。AI_API_KEY 必须留在 Cloudflare 控制台，
  //     且类型要选 Secret。
  //
  //  🔴 为什么必须写进配置、不能只放控制台（2026-10-13 实测踩过）：
  //     `wrangler deploy` 的 --keep-vars 默认为 false —— 每次部署
  //     **先删光 Worker 上所有「明文变量」**，再写入下面这段 vars；
  //     而 opennextjs-cloudflare deploy 内部就是 wrangler deploy，
  //     且不会传 --keep-vars。所以只写在控制台的明文变量，
  //     每推一次代码就消失一次（Secrets 不受影响，永不被删）。
  //
  //  🔧 换服务商：只改下面这两行 → 提交 → 自动部署。
  //     业务代码（lib/ai.ts）不用动；控制台也不用动。
  "vars": {
    // 任意「OpenAI 兼容」的 Chat Completions 端点，写到 /v1 为止
    "AI_BASE_URL": "https://api-inference.modelscope.cn/v1",
    // 🔴 魔搭上主流模型都是「推理模型」：会把 max_tokens 整段烧在思考上、
    //    正文一个字不吐。所以代码里**必须带 enable_thinking:false 关掉思考**
    //    （见 lib/ai.ts 的 postChat）。实测（2026-10-13，用本项目的
    //    /api/generate?probe=1&heavy=1&parallel=1&nothink=1 量的 3 候选真实负载）：
    //      Qwen/Qwen3.8-Flash-Next            9.2s  正文 793 字  思考 0    ✅ 用它
    //      deepseek-ai/DeepSeek-V4-Flash-0731 8.2s  正文 1022 字 思考 0    ✅ 备选
    //      Qwen/Qwen3.8-27B                  10.0s  正文 977 字  思考 0
    //      ZhipuAI/GLM-5.2                   12.8s  正文 1139 字 思考 0
    //      stepfun-ai/Step-3.7-Flash         超时（不认关思考参数，思考 4068 字）
    //    不关思考时这几个全都失败：思考 4000~8000 字、正文 0 字、finish=length。
    "AI_MODEL": "Qwen/Qwen3.8-Flash-Next",
    // 单次请求超时（毫秒）。推理类模型会先想很久，留足余量；
    // 实测 Cloudflare 上 60 秒级的非流式请求可以正常存活
    "AI_TIMEOUT_MS": "60000"
  },

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // OpenNext 需要的「自引用」服务绑定，service 名必须与上面的 name 完全一致，
      // 改名时两处一起改
      "binding": "WORKER_SELF_REFERENCE",
      "service": "duiyun"
    }
  ],

  // ─────────────────────────────────────────────────────────────────
  //  D1 数据库：账号、会话、博客文章、评论、云端收藏
  // ─────────────────────────────────────────────────────────────────
  //  代码里这样取：
  //      const { env } = getCloudflareContext();   // @opennextjs/cloudflare
  //      await env.DB.prepare("SELECT ...").bind(...).first();
  //
  //  🔴 不要用 process.env.DB —— 运行时绑定不会进 process.env；
  //     而且 OpenNext 会拿构建期烘焙值兜底，「绑定不存在」和「绑定没值」
  //     在 process.env 里长得一模一样，排查起来白费功夫。
  //
  //  改 binding 名字的话，两处要一起改：本文件 + lib/db.ts。
  //  建表 SQL 见 migrations/0001_init.sql。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "duiyun",
      "database_id": "c770053a-5cb3-42e0-bd14-0a3d5919e241"
    }
  ]
}
