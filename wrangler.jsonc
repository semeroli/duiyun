{
  // 对韵 · 智能对联生成器 —— Cloudflare Workers 部署配置
  // ---------------------------------------------------------------
  // 本项目是「零数据库」应用：收藏存在浏览器本地，服务端只有一个
  // /api/generate 路由用来安全地调用 AI（不把 Key 暴露给浏览器）。
  // 因此 **不需要 D1、不需要 KV、也不需要 R2** —— 只要一个 Worker + 静态资源。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "duiyun",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-01-01",
  // nodejs_compat                     Next.js 内部用到部分 Node API，必须开
  // global_fetch_strictly_public      允许应用向外发起 fetch（调魔搭 API 必需）
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // ─────────────────────────────────────────────────────────────────
  //  非密钥配置：写在这里，随每次部署自动下发，永远不会丢
  // ─────────────────────────────────────────────────────────────────
  //  ⚠️ 只有「不敏感」的值能放这里 —— 这个文件会进 GitHub 仓库，
  //     任何人看到都无所谓。AI_API_KEY 必须留在 Cloudflare 控制台，
  //     且类型要选 Secret。
  //
  //  🔴 为什么必须写进配置、不能只放控制台（2026-10-13 实测踩过）：
  //     `wrangler deploy` 的 --keep-vars 默认为 false —— 每次部署
  //     **先删光 Worker 上所有「明文变量」**，再写入下面这段 vars；
  //     而 opennextjs-cloudflare deploy 内部就是 wrangler deploy，
  //     且不会传 --keep-vars。所以只写在控制台的明文变量，
  //     每推一次代码就消失一次（Secrets 不受影响，永不被删）。
  //
  //  🔧 换服务商：只改下面这两行 → 提交 → 自动部署。
  //     业务代码（lib/ai.ts）不用动；控制台也不用动。
  "vars": {
    // 任意「OpenAI 兼容」的 Chat Completions 端点，写到 /v1 为止
    "AI_BASE_URL": "https://api-inference.modelscope.cn/v1",
    // 🔴 一定要选「不把输出额度烧在思考上」的模型。
    //    实测（2026-10-13 用本项目的 /api/generate?probe=1 挨个点名）：
    //      Qwen/Qwen3.8-Flash-Next            思考 46 字 / 1.1s   ✅ 用它
    //      Qwen/Qwen3.8-27B                   思考 28 字 / 1.6s   ✅ 备选
    //      deepseek-ai/DeepSeek-V4-Flash-0731 思考 15 字 / 3.2s   ✅ 备选
    //      stepfun-ai/Step-3.7-Flash          思考 137 字 / 2.9s
    //      ZhipuAI/GLM-5.2                    思考 244 字 / 2.6s
    //      Shanghai_AI_Laboratory/Intern-S2-Preview 思考 582 字
    //      ZhipuAI/GLM-4.7-Flash              思考 170 字 / 41s（太慢）
    //      MiniMax/MiniMax-M3                 直接 400
    //      deepseek-ai/DeepSeek-V4.1-Flash    思考 7557 字 / 正文 0 字 ❌ 整篇思考，正文产出不了
    "AI_MODEL": "Qwen/Qwen3.8-Flash-Next",
    // 单次请求超时（毫秒）。推理类模型会先想很久，留足余量；
    // 实测 Cloudflare 上 60 秒级的非流式请求可以正常存活
    "AI_TIMEOUT_MS": "60000"
  },

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // OpenNext 需要的「自引用」服务绑定，service 名必须与上面的 name 完全一致，
      // 改名时两处一起改
      "binding": "WORKER_SELF_REFERENCE",
      "service": "duiyun"
    }
  ]
}
